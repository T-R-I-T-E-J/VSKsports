// VSK Sports — data model.
// Prices are stored as INTEGER rupees (₹). Display-only date strings from the
// prototype (e.g. "28 Jun", "Jun 2026") are kept as String for faithful
// clickthrough; convert to DateTime when real scheduling is built.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Auth / people
// ============================================================
enum Role {
  CUSTOMER
  DEALER
  STAFF
  ADMIN
}

enum CustomerType {
  INDIVIDUAL
  ACADEMY
  DEALER
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String       @unique
  emailVerified  DateTime?
  passwordHash   String?
  image          String?
  role           Role         @default(CUSTOMER)
  customerType   CustomerType @default(INDIVIDUAL)
  phone          String?
  location       String?
  // --- compliance hooks (currently inert; standard-retail mode) ---
  dateOfBirth    DateTime? // age gating later
  verifiedAt     DateTime? // ID / licence verification later
  // ---
  loyaltyPoints  Int          @default(0)
  loyaltyTier    LoyaltyTier  @default(BRONZE)
  marketingOptIn Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  accounts              Account[]
  sessions              Session[]
  addresses             Address[]
  orders                Order[]
  reviews               Review[]
  wishlist              WishlistItem[]
  cart                  Cart?
  rewards               RewardLedger[]
  rewardRedemptions     RewardRedemption[]
  notifications         Notification[]
  returns               Return[]
  dealerApplication     DealerApplication?     @relation("DealerApplicant")
  reviewedApplications  DealerApplication[]    @relation("ReviewedApplications")
  dealerProfile         DealerProfile?
  blogPosts             BlogPost[]
  customerNotes         CustomerNote[]         @relation("CustomerNotes")
  authoredNotes         CustomerNote[]         @relation("AuthoredNotes")
  trainingRegistrations TrainingRegistration[]
  eventRegistrations    EventRegistration[]
  staffActions          StaffAction[]          @relation("StaffActions")
  inventoryAdjustments  InventoryAdjustment[]  @relation("InventoryAdjustments")
}

// Auth.js (NextAuth) adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

// ============================================================
// Catalog
// ============================================================
model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  country     String?
  color       String? // brand hex
  description String?
  products    Product[]
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  brandId          String?
  brand            Brand?    @relation(fields: [brandId], references: [id])
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  caliber          String? // ".177"
  description      String?
  tags             String[] // ["PCP","10M"]
  badge            String? // "sale" | "new" | "vsk"
  priceInr         Int
  mrpInr           Int? // "was" price
  dealerPriceInr   Int? // wholesale price for dealers
  shortDescription String?
  rating           Float?
  reviewCount      Int       @default(0)
  // --- compliance hooks (default: standard retail) ---
  restricted       Boolean   @default(false)
  requiresLicence  Boolean   @default(false)
  // ---
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  images        ProductImage[]
  variants      ProductVariant[]
  inventory     InventoryItem?
  reviews       Review[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique
  label     String // ".177 · Aluminium"
  priceInr  Int?
  stock     Int     @default(0)
}

model InventoryItem {
  id           String                @id @default(cuid())
  productId    String                @unique
  product      Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String                @unique
  stock        Int                   @default(0)
  reserved     Int                   @default(0)
  reorderPoint Int                   @default(0)
  adjustments  InventoryAdjustment[]
  updatedAt    DateTime              @updatedAt
}

// ============================================================
// Commerce
// ============================================================
model Cart {
  id        String     @id @default(cuid())
  token     String     @unique // cookie-based identifier (guest + logged-in)
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id           String  @id @default(cuid())
  cartId       String
  cart         Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  variantLabel String?
  quantity     Int     @default(1)

  @@unique([cartId, productId, variantLabel])
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id                String        @id @default(cuid())
  number            String        @unique // "VSK-2026-0417"
  userId            String?
  user              User?         @relation(fields: [userId], references: [id])
  addressId         String?
  address           Address?      @relation(fields: [addressId], references: [id])
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  subtotalInr       Int
  gstInr            Int           @default(0) // computed via computeTotals (GST_RATE)
  shippingInr       Int           @default(0)
  discountInr       Int           @default(0)
  totalInr          Int
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id])
  razorpayOrderId   String?
  razorpayPaymentId String?
  trackingNumber    String?
  courier           String?
  adminNotes        String?
  items             OrderItem[]
  returns           Return[]
  events            OrderEvent[]
  emails            EmailLog[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model OrderItem {
  id           String       @id @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id])
  name         String
  variantLabel String?
  unitPriceInr Int
  quantity     Int
  returnItems  ReturnItem[]
}

enum CouponType {
  FLAT
  PERCENT
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType @default(FLAT)
  value       Int // rupees (FLAT) or percent (PERCENT)
  minOrderInr Int?
  active      Boolean    @default(true)
  expiresAt   DateTime?
  orders      Order[]
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id])
  authorName   String
  rating       Int
  title        String?
  body         String
  status       ReviewStatus @default(PENDING)
  orderId      String? // verified-purchase link
  helpfulCount Int          @default(0)
  createdAt    DateTime     @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model RewardLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int // +earn / -redeem
  reason    String
  createdAt DateTime @default(now())
}

enum NotificationType {
  ORDER
  REWARD
  SYSTEM
  PROMO
  REVIEW
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model Return {
  id          String       @id @default(cuid())
  rmaNumber   String?      @unique
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  reason      String
  comment     String?
  status      ReturnStatus @default(REQUESTED)
  refundInr   Int?
  resolution  String?
  items       ReturnItem[]
  processedAt DateTime?
  createdAt   DateTime     @default(now())
}

// ============================================================
// Partners
// ============================================================
enum DealerAppStatus {
  PENDING
  APPROVED
  REJECTED
}

model DealerApplication {
  id              String          @id @default(cuid())
  userId          String?         @unique
  user            User?           @relation("DealerApplicant", fields: [userId], references: [id])
  business        String
  contactName     String
  email           String
  phone           String?
  city            String?
  state           String?
  gstNumber       String?
  businessType    String?
  yearsInBusiness String?
  message         String?
  status          DealerAppStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?           @relation("ReviewedApplications", fields: [reviewedById], references: [id])
  reviewNotes     String?
  terms           String? // agreed terms on approval (margin, territory, credit)
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
}

// Storefront "find a dealer" directory entry
model Dealer {
  id        String   @id @default(cuid())
  name      String
  city      String?
  createdAt DateTime @default(now())
}

// ============================================================
// Content
// ============================================================
enum EventStatus {
  UPCOMING
  LIVE
  PAST
}

model Event {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  date          String // display string ("28 Jun")
  location      String?
  category      String?
  status        EventStatus         @default(UPCOMING)
  prizePoolInr  Int?
  capacity      Int?
  imageNote     String? // image-slot placeholder text
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model TrainingBatch {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  title         String
  date          String
  location      String?
  duration      String?
  level         TrainingLevel          @default(BEGINNER)
  priceInr      Int?
  capacity      Int?
  spotsNote     String?
  imageNote     String?
  registrations TrainingRegistration[]
  createdAt     DateTime               @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String?
  title       String
  excerpt     String?
  body        String?
  coverImage  String?
  readTime    String?
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  published   Boolean  @default(true)
  publishedAt String? // display string ("Jun 2026")
  createdAt   DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// ============================================================
// Order tracking / fulfilment history
// ============================================================
model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

// ============================================================
// Returns — line items
// ============================================================
model ReturnItem {
  id          String     @id @default(cuid())
  returnId    String
  return      Return     @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  name        String
  quantity    Int        @default(1)
}

// ============================================================
// CRM — staff notes on a customer
// ============================================================
model CustomerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("CustomerNotes", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("AuthoredNotes", fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

// ============================================================
// Dealer portal — approved dealer profile
// ============================================================
enum DealerTier {
  STANDARD
  GOLD
  PLATINUM
}

model DealerProfile {
  id             String     @id @default(cuid())
  userId         String     @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName   String
  gstNumber      String?
  territory      String?
  marginPct      Int        @default(30)
  tier           DealerTier @default(STANDARD)
  creditLimitInr Int?
  approvedAt     DateTime?
  createdAt      DateTime   @default(now())
}

// ============================================================
// Rewards — redeemable catalog + redemptions
// ============================================================
model RewardItem {
  id          String             @id @default(cuid())
  title       String
  description String?
  pointsCost  Int
  active      Boolean            @default(true)
  redemptions RewardRedemption[]
  createdAt   DateTime           @default(now())
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

model RewardRedemption {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardItemId String?
  rewardItem   RewardItem?      @relation(fields: [rewardItemId], references: [id])
  title        String
  pointsSpent  Int
  status       RedemptionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
}

// ============================================================
// Training / event registrations
// ============================================================
enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  WAITLIST
}

model TrainingRegistration {
  id         String             @id @default(cuid())
  batchId    String
  batch      TrainingBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?              @relation(fields: [userId], references: [id])
  name       String
  phone      String
  email      String?
  experience String?
  status     RegistrationStatus @default(PENDING)
  createdAt  DateTime           @default(now())
}

model EventRegistration {
  id         String             @id @default(cuid())
  eventId    String
  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?              @relation(fields: [userId], references: [id])
  name       String
  phone      String
  category   String?
  discipline String?
  status     RegistrationStatus @default(PENDING)
  createdAt  DateTime           @default(now())
}

// ============================================================
// Transactional email log
// ============================================================
enum EmailType {
  ORDER_CONFIRMATION
  SHIPPING_UPDATE
  WELCOME
  REVIEW_REQUEST
  DEALER_APPROVED
  PASSWORD_RESET
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model EmailLog {
  id        String      @id @default(cuid())
  to        String
  type      EmailType
  subject   String
  status    EmailStatus @default(QUEUED)
  orderId   String?
  order     Order?      @relation(fields: [orderId], references: [id])
  createdAt DateTime    @default(now())
}

// ============================================================
// Loyalty tier (customer rewards)
// ============================================================
enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// ============================================================
// Staff audit log (admin/CRM)
// ============================================================
model StaffAction {
  id        String   @id @default(cuid())
  staffId   String
  staff     User     @relation("StaffActions", fields: [staffId], references: [id], onDelete: Cascade)
  action    String // e.g. ORDER_STATUS_UPDATED, REVIEW_APPROVED
  entity    String // e.g. Order, Product, Review
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
}

// ============================================================
// Inventory adjustment history
// ============================================================
model InventoryAdjustment {
  id              String        @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  delta           Int // +receive / -correction
  reason          String?
  staffId         String?
  staff           User?         @relation("InventoryAdjustments", fields: [staffId], references: [id])
  createdAt       DateTime      @default(now())
}

// ============================================================
// i18n translations (EN + HI; Hindi copy stubbed until supplied)
// ============================================================
model Translation {
  id        String @id @default(cuid())
  locale    String // "en" | "hi"
  namespace String @default("common")
  key       String
  value     String

  @@unique([locale, namespace, key])
}
