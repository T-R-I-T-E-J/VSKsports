# ─────────────────────────────────────────────────────────────
# VSK Sports — environment template. Copy to .env and fill in.
# In production (Vercel), set these in the project's Environment Variables.
# ─────────────────────────────────────────────────────────────

# Database — local Postgres runs via docker-compose (npm run db:up).
# In prod, use your managed Postgres (e.g. Neon) connection string.
DATABASE_URL="postgresql://vsk:vsk@127.0.0.1:5544/vsk_sports?schema=public"
# Direct (non-pooled) connection, used only by `prisma migrate`. Locally it is
# the same Docker Postgres as above.
DIRECT_URL="postgresql://vsk:vsk@127.0.0.1:5544/vsk_sports?schema=public"

# --- Production (Neon / hosted Postgres) -------------------------------------
# DATABASE_URL must be the POOLED endpoint (the `-pooler` host) — every
# serverless instance opens its own pool, so an unpooled URL exhausts Postgres
# connections. DIRECT_URL must be the direct endpoint: `prisma migrate deploy`
# cannot run over a transaction-mode pooler.
#   DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require&connection_limit=1"
#   DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DB?sslmode=require"

# Shared secret for the Vercel cron that prunes expired rate-limit rows.
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`. The endpoint fails
# closed (503) when this is unset, so it must exist in production.
CRON_SECRET=""

# ── Auth.js (v5) ──
# REQUIRED. Generate a strong per-environment secret:  npx auth secret
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# NEVER reuse the dev value in production.
AUTH_SECRET=""
# Public site URL (used for auth callbacks, canonical/OG URLs, emails).
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Razorpay (UPI / cards / netbanking) ──
# REQUIRED in production. When these are blank, checkout runs in mock mode in
# development only — in production, checkout is blocked until they are set.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Webhook secret configured in the Razorpay dashboard (verifies webhook payloads).
RAZORPAY_WEBHOOK_SECRET=""

# ── Email (SMTP) ──
# When SMTP_HOST is set, real email is sent via nodemailer; otherwise emails are
# logged to the server console (dev). Port 465 = implicit TLS, 587 = STARTTLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="VSK Sports <no-reply@vsksports.in>"

# ── File storage / uploads ──
# STORAGE_DRIVER: "local" (dev) or "blob" (Vercel Blob in prod).
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# ── Seed ──
# Password for seeded demo accounts (admin/dealer/customers). Defaults to a known
# dev value; seeding is REFUSED in production unless SEED_PASSWORD is set here.
SEED_PASSWORD=""
